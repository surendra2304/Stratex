# ==============================================================================
# ENVIRONMENT VARIABLES CONFIGURATION (.env.example)
# ==============================================================================
# Never commit your actual `.env` file to Git.

# --- Exchange Credentials ---
API_KEY="YOUR_API_KEY_HERE"
SECRET_KEY="YOUR_SECRET_KEY_HERE"

# --- Execution Modes ---
# TRADING_MODE can be: "PAPER", "TESTNET" (Spot), or "FUTURES" (USD-M Futures Testnet)
TRADING_MODE="PAPER"
PAPER_SAFE_MODE="True"

# --- Futures Settings (When TRADING_MODE="FUTURES") ---
FUTURES_LEVERAGE="5"
FUTURES_MARGIN_TYPE="ISOLATED"

# --- Safeties (Must explicitly be True to enable non-paper paths) ---
TESTNET_ENABLED="False"
TESTNET_ONLY="TRUE"
LIVE_TRADING_ENABLED="False"
RESEARCH_MODE="0"

# --- Gemini AI Integration ---
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"
GEMINI_MODEL="gemini-flash-lite-latest"
GEMINI_ENABLED="True"

# --- AI-Universe Multi-Agent Advisory Intelligence ---
AI_UNIVERSE_BASE_URL="http://localhost:8000"
AI_UNIVERSE_API_KEY="YOUR_AI_UNIVERSE_API_KEY_HERE"
AI_UNIVERSE_ENABLED="True"
ADVISORY_SHADOW_MODE="True"
ADVISORY_INTERVAL_HOURS="4.0"
ADVISORY_TIMEOUT_SECONDS="120"
