# ==============================================================================
# .gitignore - Files to NEVER commit to GitHub
# ==============================================================================

# ── Secrets ────────────────────────────────────────────────────────────────────
.env
.env.*

# ── Python cache ───────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# ── Virtual environments ───────────────────────────────────────────────────────
venv/
env/
.venv/

# ── IDE / OS ───────────────────────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

# ── Test artifacts ─────────────────────────────────────────────────────────────
.pytest_cache/
htmlcov/
.coverage

# ── Logs ───────────────────────────────────────────────────────────────────────
bot.log
bot.log.*
test_bot.log
*.log

# ── Runtime state / JSON state files (Untracked local temps only) ─────────────
sim_heartbeat.json
sim_portfolio.json
sim_session.json
bot.pid
testnet_portfolio.json.tmp

# ── Data cache ─────────────────────────────────────────────────────────────────
data_cache/
cache_*.csv

# ── Diagnostic / debug dumps ───────────────────────────────────────────────────
dashboard_debug.txt
diagnostic_probs.txt
diagnostic_profit.txt

# ── Scratch / experiments / backup ─────────────────────────────────────────────
scratch/
backup/
experiments/

# ── Backtest results ───────────────────────────────────────────────────────────
backtest_results/

# ── Simulation files ───────────────────────────────────────────────────────────
# ── Legacy generated docs ───────────────────────────────────────────────────────
FINAL_24_7_TESTNET_VERIFICATION.md
FINAL_TRADING_SYSTEM_AUDIT.md
FINAL_VERIFICATION_COMPLETE.md
PRODUCTION_STRATEGIES.md

# ── Heartbeat variants ─────────────────────────────────────────────────────────
*heartbeat.json