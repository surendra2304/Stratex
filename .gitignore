# ==============================================================================
# .gitignore - Files to NEVER commit to GitHub
# ==============================================================================

# SECRET: API keys and runtime mode — NEVER push to GitHub!
.env
.env.*

# Non-secret strategy configuration — safe to version control
# config_strategy.py is intentionally NOT listed here (tracked by git)

# Python cache files
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Virtual environments
venv/
env/
.venv/

# Trade logs and local state
trade_log.csv
active_trades.json
paper_trade_ledger.jsonl
paper_equity_curve.jsonl
paper_portfolio.json
testnet_portfolio.json*
testnet_opportunity_log.jsonl
testnet_trade_ledger.jsonl
heartbeat.json
sim_*.json
sim_*.json.tmp
bot.log
session/

# Testing artifacts
.pytest_cache/
htmlcov/
.coverage
.vscode/
.idea/
*.swp

# OS files
.DS_Store
Thumbs.db
dashboard_debug.txt
forward_health.json
forward_signal_log.jsonl
testnet_equity_history.jsonl
experiments/*.json
data_cache/
bot.pid