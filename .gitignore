# ==============================================================================
# .gitignore - Files to NEVER commit to GitHub
# ==============================================================================

# ── Secrets ────────────────────────────────────────────────────────────────────
.env
.env.*

# ── Python cache ───────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# ── Virtual environments ───────────────────────────────────────────────────────
venv/
env/
.venv/

# ── IDE / OS ───────────────────────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

# ── Test artifacts ─────────────────────────────────────────────────────────────
.pytest_cache/
htmlcov/
.coverage

# ── Logs ───────────────────────────────────────────────────────────────────────
bot.log
bot.log.*
test_bot.log
*.log

# ── Runtime state / JSON state files ──────────────────────────────────────────
active_trades.json
heartbeat.json
testnet_heartbeat.json
sim_heartbeat.json
health.json
forward_health.json
engine-health.json
bot.pid
status.json
render_status.json
render_status_audit.json

# ── Trade ledgers & portfolio state ───────────────────────────────────────────
*.jsonl
trade_log.csv
paper_trade_ledger.jsonl
paper_equity_curve.jsonl
paper_portfolio.json
testnet_portfolio.json
testnet_portfolio.json.tmp
testnet_opportunity_log.jsonl
testnet_trade_ledger.jsonl
testnet_equity_history.jsonl
testnet_initial_deposit.json
testnet_baseline.json
forward_reconciliation.jsonl
forward_signal_log.jsonl

# ── Scanner / market data snapshots ───────────────────────────────────────────
render_scanner.json
render_scanner_audit.json
render_trades.json
render_trades_audit.json
binance_state.json
sim_portfolio.json
sim_session.json
forward_*.json

# ── Data cache ─────────────────────────────────────────────────────────────────
data_cache/
cache_*.csv

# ── Diagnostic / debug dumps ───────────────────────────────────────────────────
dashboard_debug.txt
diagnostic_probs.txt
diagnostic_profit.txt

# ── Scratch / experiments / backup ─────────────────────────────────────────────
scratch/
backup/
experiments/

# ── Backtest results ───────────────────────────────────────────────────────────
backtest_results/

# ── Simulation files ───────────────────────────────────────────────────────────
sim_*.json
sim_*.json.tmp

# ── Heartbeat variants ─────────────────────────────────────────────────────────
*heartbeat.json