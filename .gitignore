# ==============================================================================
# .gitignore - Files to NEVER commit to GitHub
# ==============================================================================

# ── Secrets ────────────────────────────────────────────────────────────────────
.env
.env.*
*.key

# ── Python cache ───────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# ── Virtual environments ───────────────────────────────────────────────────────
venv/
env/
.venv/

# ── IDE / OS ───────────────────────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

# ── Logs / pid files ───────────────────────────────────────────────────────────
*.log
bot.log.*
bot.pid
*.pid

# ── Runtime state (local only, regenerated at runtime) ─────────────────────────
active_trades.json
advisory_quality_report.json
binance_state.json
deployment_audit_log.json
engine-health.json
execution_intents.json
forward_health.json
health.json
*heartbeat.json
panic_state.json
slippage_log.json
paper_portfolio.json
render_scanner.json
render_scanner_audit.json
render_status.json
render_status_audit.json
render_trades.json
render_trades_audit.json
runtime_leases.json
strategy_registry.json
testnet_initial_deposit.json
testnet_portfolio.json
testnet_portfolio.json.tmp

# ── Runtime audit / event ledgers (jsonl) ──────────────────────────────────────
*.jsonl
!testnet_trade_ledger.jsonl

# ── Model / binary artifacts (retrainable) ─────────────────────────────────────
*.pkl
*.joblib

# ── Generated outputs (regenerated by scripts at runtime) ──────────────────────
incident_reports/
reports/
compliance_reports/
diary/
optimization_results/
backtest_results/
trade_log.csv
cache_*.csv
lower_tf_report.md
retired_genomes_archive.jsonl

# ── Data cache / bulk market data (re-fetchable via scripts) ───────────────────
data_cache/
research/upgrade_2026_08/data/

# ── Scratch / experiments / backups ────────────────────────────────────────────
scratch/
backup/
backup_ui/
state_backups/
experiments/
experiments_ab/

# ── Misc runtime junk ──────────────────────────────────────────────────────────
screenshot*.png
dashboard_debug.txt
diagnostic_probs.txt
diagnostic_profit.txt

# ── Legacy generated docs ──────────────────────────────────────────────────────
FINAL_24_7_TESTNET_VERIFICATION.md
FINAL_TRADING_SYSTEM_AUDIT.md
FINAL_VERIFICATION_COMPLETE.md
PRODUCTION_STRATEGIES.md
